# Bright Data Credentials
# Get these from: https://brightdata.com/cp/dashboard
BRIGHT_DATA_API_TOKEN=your_api_token_here

# Bright Data Web Scraper API Settings
# Create a TikTok scraper at: https://brightdata.com/products/web-scraper
BRIGHT_DATA_DATASET_ID=your_tiktok_dataset_id

# Optional: Proxy credentials if using Bright Data proxies
BRIGHT_DATA_PROXY_HOST=brd.superproxy.io
BRIGHT_DATA_PROXY_PORT=22225
BRIGHT_DATA_PROXY_USERNAME=your_proxy_username
BRIGHT_DATA_PROXY_PASSWORD=your_proxy_password

# App Settings
MIN_FOLLOWERS=50000
MAX_FOLLOWERS=150000
VIRAL_MULTIPLIER=10
HOURS_LOOKBACK=24
MAX_RESULTS=20
